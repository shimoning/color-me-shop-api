{
    "name": "shimoning/color-me-shop-api",
    "type": "library",
    "description": "Color Me Shop API client",
    "keywords": [
        "ec",
        "client",
        "api",
        "shop",
        "gmo",
        "color me"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "0.7.4",
    "license": "MIT",
    "authors": [
        {
            "name": "Shimon Haga",
            "email": "shimon.haga@shimoning.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2"
    },
    "require-dev": {
        "psy/psysh": "^0.12",
        "vlucas/phpdotenv": "^5.5",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Shimoning\\ColorMeShopApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shimoning\\ColorMeShopApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "client": [
            "@php client"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:coverage": [
            "@php vendor/bin/phpunit --coverage-html coverage"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --no-progress"
        ],
        "check": [
            "@composer validate --strict --no-check-version",
            "@analyse",
            "@test"
        ]
    }
}
